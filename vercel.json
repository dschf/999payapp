{
  "rewrites": [
    { "source": "/invitation", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/invitation?code=KC8AH5F", "statusCode": 302 }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Content-Type", "value": "application/javascript" }]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=999Pay_6.0.2.6.apk" }
      ]
    }
  ]
}
